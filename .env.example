# 复制为 .env 后填写真实值（.env 已在 .gitignore 中，切勿提交）

# SyncClipboard 服务端账号（docker-compose 与 synchub_server.py 下发的客户端脚本使用）
SYNCCLIPBOARD_USERNAME=admin
SYNCCLIPBOARD_PASSWORD=change-me

# 客户端 / 测试脚本访问服务器
SYNCHUB_SERVER_URL=https://020814.xyz
SYNCHUB_SERVER_HOST=020814.xyz
SYNCHUB_USER=admin
SYNCHUB_PASSWORD=change-me

# Android root 守护脚本（格式：用户名:密码）
SYNCHUB_AUTH=admin:change-me

# 部署 / 验收脚本 SSH 到 VPS
SYNCHUB_VPS_HOST=your.vps.ip.or.host
SYNCHUB_VPS_PORT=22
SYNCHUB_VPS_USER=root
SYNCHUB_VPS_PASSWORD=change-me

# Android release 签名（也可用 src/keystore.properties）
SYNCHUB_KEYSTORE_FILE=keystore/your-release.jks
SYNCHUB_KEYSTORE_PASSWORD=change-me
SYNCHUB_KEY_ALIAS=synchub
SYNCHUB_KEY_PASSWORD=change-me
