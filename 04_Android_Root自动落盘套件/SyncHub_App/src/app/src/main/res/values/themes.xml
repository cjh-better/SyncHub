<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SyncHub" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:colorAccent">@color/accent</item>
    </style>
    <style name="Theme.SyncHub.Transparent" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowNoDisplay">false</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
    <color name="bg">#F5F5F7</color>
    <color name="accent">#007AFF</color>
</resources>
